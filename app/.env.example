# RotinaTEA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env — ele está listado no .gitignore.

# ------------------------------------------------------------------
# Supabase (Banco de Dados PostgreSQL + Auth + Realtime)
# Obtenha em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-chave-anonima-publica>

# ------------------------------------------------------------------
# Ambiente da aplicação
# Valores possíveis: development | production
# ------------------------------------------------------------------
VITE_APP_ENV=development
